{
  // F5 стартира сървъра в режим за дебъгване (може да слагаш точки на прекъсване).
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "▶ Стартирай сървъра",
      "program": "${workspaceFolder}/server/server.js",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Тестове",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning", "--test"],
      "console": "integratedTerminal"
    }
  ]
}
